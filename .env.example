# Copy to .env (make setup does this). Dev-only keys; generate real ones with:
#   python3 -c "import secrets; print('bk_' + secrets.token_urlsafe(24))"
BOUNCER_KEY_OPS_COPILOT=bk_dev_ops_copilot
BOUNCER_KEY_DEV_ASSISTANT=bk_dev_dev_assistant
BOUNCER_KEY_INTERN_BOT=bk_dev_intern_bot
BOUNCER_KEY_PLAYGROUND=bk_dev_playground

BOUNCER_POLICY=policy/bouncer.yaml
BOUNCER_PORT=8700
JUDGE_PORT=8701
JUDGE_BACKEND=clef-mlx
CLEF_MLX_PATH=models/clef-flash-mlx-4bit
T1_MODEL_PATH=models/deberta-pi-v2/onnx
OLLAMA_URL=http://localhost:11434

# MCP gateway (/mcp on the gateway port) and the demo MCP server
BOUNCER_MCP_UPSTREAM=http://127.0.0.1:8703/mcp
BOUNCER_MCP_RECHECK_SECONDS=0
BOUNCER_MCP_URL=http://localhost:8700/mcp
DEMO_MCP_ADMIN_URL=http://127.0.0.1:8703
# Admin API (/api, /admin, /reports, used by the dashboard). Leave empty to get a random token per run
# (make dev prints a dashboard link that carries it). "off" disables the check: never do that on a shared host.
BOUNCER_ADMIN_TOKEN=
